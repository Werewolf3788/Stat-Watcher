    <!-- Live NY Clock & Domain Routing Guard -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const updateNYClock = () => {
                const el = document.getElementById('nyBuildTimestamp');
                if (!el) return;
                const now = new Date();
                const nyStr = now.toLocaleTimeString('en-US', {
                    timeZone: 'America/New_York',
                    hour12: false,
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });
                el.innerText = `New York Time (24h): ${nyStr}`;
            };
            updateNYClock();
            setInterval(updateNYClock, 1000);

            const enforceDomainRouting = () => {
                document.querySelectorAll('a[href]').forEach(link => {
                    const href = link.getAttribute('href');
                    if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;
                    try {
                        const parsed = new URL(href, window.location.href);
                        if (parsed.origin === window.location.origin) {
                            link.removeAttribute('target');
                            link.removeAttribute('rel');
                        } else {
                            link.setAttribute('target', '_blank');
