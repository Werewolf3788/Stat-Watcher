      "id": "walkthrough_wm_12",
      "mission_name": "Get Free",
      "region": "Whitetail Mountains (Missable Quest)",
      "objectives": [
        "Speak to Eli at Wolf's Den.",
        "Infiltrate Grand View Hotel quietly to locate Briggs.",
        "Play the deprogramming cassette tape in the upper room.",
        "Defend Briggs against massive ground, water, and air assaults."
